{
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
        { "source": "/cart", "destination": "/app-shell" },
        { "source": "/checkout", "destination": "/app-shell" },
        { "source": "/wishlist", "destination": "/app-shell" },
        { "source": "/signin", "destination": "/app-shell" },
        { "source": "/profile", "destination": "/app-shell" },
        { "source": "/custom-order", "destination": "/app-shell" },
        { "source": "/application-status", "destination": "/app-shell" },
        { "source": "/distributor", "destination": "/app-shell" },
        { "source": "/admin/:path*", "destination": "/app-shell" },
        { "source": "/products/:slug", "destination": "/app-shell" },
        { "source": "/learn/:slug", "destination": "/app-shell" }
    ],
    "headers": [
        {
            "source": "/(cart|checkout|wishlist|signin|profile|custom-order|application-status|distributor|admin)(.*)",
            "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
        },
        {
            "source": "/(llms.txt|llms-full.txt)",
            "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
        },
        {
            "source": "/assets/(.*)",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        }
    ]
}
